left;verticalAlign=top;spacingLeft=17;spacingTop=12;fontFamily=Arial;fontSize=16;fontColor=#18314A;" vertex="1" parent="1"><mxGeometry x="48" y="132" width="990" height="965" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;CLOUD BACKEND · VitaStore&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;Контейнеры могут размещаться на PaaS / managed services&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECF8F0;strokeColor=#A6CFB6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=17;spacingTop=12;fontFamily=Arial;fontSize=16;fontColor=#18314A;" vertex="1" parent="1"><mxGeometry x="1085" y="132" width="790" height="965" as="geometry" /></mxCell><mxCell id="f2" value="&lt;b&gt;EDGE RUNTIME · локально на устройстве / в компактном шлюзе&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;Не является сервером БД магазина; работает при отсутствии WAN&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FEF4E4;strokeColor=#DAB77F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=17;spacingTop=12;fontFamily=Arial;fontSize=16;fontColor=#18314A;" vertex="1" parent="1"><mxGeometry x="84" y="409" width="917" height="412" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Кассир&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Person]&lt;br/&gt;Пробивает покупку&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5C6D5;strokeWidth=2;fontColor=#5A6F87;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86" y="226" width="220" height="111" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Web POS / Tablet App&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: PWA или лёгкое app]&lt;br/&gt;UI, сканирование, режим offline&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3C6E4;strokeWidth=2;fontColor=#15568E;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="366" y="211" width="360" height="142" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Hardware Adapter (HAL)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: local daemon]&lt;br/&gt;Единый API → драйверы ККТ и EFT&lt;br/&gt;USB / COM / LAN, mTLS/loopback&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4CBD3;strokeWidth=2;fontColor=#4F6272;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="119" y="500" width="348" height="151" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Offline Transaction Engine&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: on-device runtime]&lt;br/&gt;Кэш товаров/цен, расчёт наличных&lt;br/&gt;Стейт-машина чека, бизнес-ограничения&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3C6E4;strokeWidth=2;fontColor=#15568E;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="511" y="500" width="382" height="151" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Durable Outbox&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: encrypted local storage]&lt;br/&gt;Журнал операций, idempotency keys&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#83BDB0;strokeWidth=2;fontColor=#185F5D;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="511" y="686" width="382" height="101" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Драйверы / SDK устройств&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-s