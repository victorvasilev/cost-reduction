<mxfile host="app.diagrams.net" agent="VitaStore C4 Architecture" version="24.7.17" type="device"><diagram id="VitaStoreC4Page1" name="AS-IS · C4 Containers"><mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="f0" value="&lt;b&gt;МАГАЗИН · существующая инфраструктура&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;Локальные приложения и серверы, индивидуальные для приобретённых точек&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDF3FC;strokeColor=#9EBBE0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=17;spacingTop=12;fontFamily=Arial;fontSize=16;fontColor=#18314A;" vertex="1" parent="1"><mxGeometry x="48" y="126" width="930" height="626" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;HQ · централизованные системы VitaStore&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;Существующие корпоративные приложения&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECF8F0;strokeColor=#A6CFB6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=17;spacingTop=12;fontFamily=Arial;fontSize=16;fontColor=#18314A;" vertex="1" parent="1"><mxGeometry x="1020" y="126" width="565" height="626" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Кассир&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;Работа с покупателем&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5C6D5;strokeWidth=2;fontColor=#5A6F87;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="83" y="236" width="190" height="102" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Толстый POS-клиент&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: desktop application]&lt;br/&gt;Продажи, локальные правила, драйверы&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D89D9B;strokeWidth=2;fontColor=#8C3A3A;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="218" width="290" height="144" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Локальный сервер / БД&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: application + database]&lt;br/&gt;Товары, цены, продажи&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D89D9B;strokeWidth=2;fontColor=#8C3A3A;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="676" y="218" width="264" height="144" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Драйвер ККТ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Локальный компонент]&lt;br/&gt;Фискализация и печать чеков&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4CBD3;strokeWidth=2;fontColor=#4F6272;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="290" height="127" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Драйвер эквайринга&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Локальный компонент]&lt;br/&gt;Зависит от модели терминала&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4CBD3;strokeWidth=2;fontColor=#4F6272;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="676" y="500" width="264" height="127" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Фискальный регистратор&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Device: KKT + ФН]&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4CBD3;strokeWidth=2;fontColor=#4F6272;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="655" width="290" height="71" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Банковский терминал&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Device: EFT]&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4CBD3;strokeWidth=2;fontColor=#4F6272;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="676" y="655" width="264" height="71" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;ERP / каталог&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: корпоративная ERP]&lt;br/&gt;Мастер-данные, учёт, цены&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3C6E4;strokeWidth=2;fontColor=#15568E;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="212" width="450" height="120" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Promo Engine&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: HQ service]&lt;br/&gt;Единые промо-правила&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DCFB7;strokeWidth=2;fontColor=#216A4E;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="390" width="450" height="120" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Smart Fulfillment&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;color:#5B6D7E&quot;&gt;[Container: HQ service]&lt;br/&gt;Маршрутизация заказов, C&amp;amp;C&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DCFB7;strokeWidth=2;fontColor=#216A4E;fontFamily=Arial;fontSize=17;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="572" width="450" height="120" as="geometry" /></mxCell><mxCell id="t12" value="¹ Связь POS ↔ ERP реконструирована по описанию задачи; протокол, периодичность и границы ответственности нужно сверить с артефактом 1." style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#5B6D7E;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="54" y="788" width="1566" height="22.099999999999998" as="geometry" /></mxCell><mxCell id="t13" value="VitaStore · C4 Container Diagram · AS-IS" style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#18314A;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="44" width="1565" height="51.0" as="geometry" /></mxCell><mxCell id="t14" value="Реконструкция по условиям задания — без исходной схемы не считается подтверждённым фактом." style="whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#5B6D7E;fontSize=15;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="55" y="93" width="1565" height="25.5" as="geometry" /></mxCell><mxCell id="e15" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#68829A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="273" y="287" as="sourcePoint" /><mxPoint x="320" y="287" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e16" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#68829A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x=